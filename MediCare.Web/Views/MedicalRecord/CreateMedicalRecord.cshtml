@model MediCare.Web.ViewModels.MedicalRecordViewModel

@{
    ViewData["Title"] = "Create Medical Record";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow">

                <div class="card-header">
                    <h3 class="mb-0">Create Medical Record</h3>
                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <form asp-action="CreateMedicalRecord" method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="PatientId" class="form-label">
                                Patient
                            </label>

                            <select asp-for="PatientId"
                                    class="form-select">

                                <option value="">
                                    -- Select Patient --
                                </option>

                                @foreach (var patient in Model.Patients)
                                {
                                    <option value="@patient.Id">
                                        @patient.DisplayName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="PatientId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Diagnosis"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Diagnosis"
                                      rows="4"
                                      class="form-control">
                        </textarea>

                            <span asp-validation-for="Diagnosis"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Symptoms"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Symptoms"
                                      rows="4"
                                      class="form-control">
                        </textarea>

                        </div>

                        <div class="mb-3">

                            <label asp-for="TreatmentPlan"
                                   class="form-label">
                                Treatment Plan
                            </label>

                            <textarea asp-for="TreatmentPlan"
                                      rows="4"
                                      class="form-control">
                        </textarea>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notes"
                                      rows="4"
                                      class="form-control">
                        </textarea>

                        </div>

                        <div class="d-flex justify-content-end">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Medical Record
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
