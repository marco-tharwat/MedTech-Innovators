@using MediCare.Data.Models
@using MediCare.Data.Models.Enum
@model List<Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">My Appointments</h2>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            You don't have any appointments yet.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Doctor</th>
                                    <th>Specialization</th>
                                    <th>Date &amp; Time</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model)
                                {
                                    var canModify = (appointment.Status == Status.Pending || appointment.Status == Status.Confirmed)
                                                     && appointment.AppointmentDate > DateTime.Now;

                                    <tr>
                                        <td class="ps-4">Dr. @appointment.Doctor.User.FullName</td>
                                        <td>@appointment.Doctor.Specialization.Name</td>
                                        <td>@appointment.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td>
                                            <span class="badge rounded-pill @GetStatusBadgeClass(appointment.Status)">
                                                @appointment.Status
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (canModify)
                                            {
                                                <a asp-action="Reschedule" asp-controller="Appointment"
                                                   asp-route-id="@appointment.Id"
                                                   class="btn btn-sm btn-outline-primary me-2">
                                                    Reschedule
                                                </a>

                                                <form asp-action="Cancel" asp-controller="Appointment"
                                                      asp-route-id="@appointment.Id"
                                                      method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Cancel this appointment?');">
                                                        Cancel
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">&mdash;</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(Status status) => status switch
    {
        Status.Pending => "bg-warning text-dark",
        Status.Confirmed => "bg-primary",
        Status.Completed => "bg-success",
        Status.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}
