@{
    Layout = "_AdminLayout";
}
@using MediCare.Data.Models
@model IEnumerable<Patient>

@{
    ViewData["Title"] = "Manage Patients";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Manage Patients</h2>
    <a asp-controller="Patient" asp-action="Create" class="btn btn-primary">Add Patient</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Blood Type</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.User?.FullName</td>
                <td>@patient.User?.Email</td>
                <td>@patient.BloodType</td>
                <td>
                    <a asp-action="UpdatePatients" asp-route-id="@patient.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-controller="Patient" asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-controller="Patient" asp-action="Delete" asp-route-id="@patient.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Dashboard" class="btn btn-secondary">Back</a>