@using MediCare.Data.Models
@model IEnumerable<Notification>

@{
    ViewData["Title"] = "My Notifications";
    // Any authenticated user (admin/doctor/patient) keeps the sidebar shell;
    // ViewBag.Role is always set for a signed-in user reaching this action.
    Layout = string.IsNullOrEmpty((string)ViewBag.Role) ? "_Layout" : "_AdminLayout";
}

<div class="@(Layout == "_AdminLayout" ? "" : "container py-5")">
    <div class="page-header">
        <h1>My Notifications</h1>
        <p>Booking confirmations, reminders and clinic updates.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="card p-5 text-center text-muted">
            <div style="font-size:2.5rem;">🔔</div>
            <p class="mb-0 mt-2">You have no notifications yet.</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var n in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center @(n.IsRead ? "" : "list-group-item-primary")">
                    <div>
                        <p class="mb-1">@n.Message</p>
                        <small class="text-muted">@n.CreatedAt.ToString("g")</small>
                    </div>
                    @if (!n.IsRead)
                    {
                        <span class="badge-status is-info">New</span>
                    }
                </div>
            }
        </div>
    }

    @if (ViewBag.Role == "admin")
    {
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-primary mt-4">← Back to Dashboard</a>
    }
    else if (ViewBag.Role == "doctor")
    {
        <a asp-controller="Doctor" asp-action="Index" class="btn btn-outline-primary mt-4">← Back to Dashboard</a>
    }
    else if (ViewBag.Role == "patient")
    {
        <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-primary mt-4">← Back to Dashboard</a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary mt-4">← Back to Home</a>
    }
</div>