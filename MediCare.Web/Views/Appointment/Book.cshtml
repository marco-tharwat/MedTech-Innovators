@using MediCare.Web.ViewModels
@model BookAppointmentViewModel

@{
    Layout = "_AdminLayout";
    var isReschedule = Model.AppointmentId.HasValue;
    ViewData["Title"] = isReschedule ? "Reschedule Appointment" : "Book Appointment";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="fw-bold">@(isReschedule ? "Reschedule Appointment" : "Book Appointment")</h2>
                        <p class="text-muted mb-0">
                            with <strong>Dr. @Model.DoctorName</strong> &middot; @Model.SpecializationName
                        </p>
                    </div>

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    @* ---- Date picker (GET request - reloads the page with the new date) ---- *@
                    <form method="get"
                          asp-action="@(isReschedule ? "Reschedule" : "Book")"
                          asp-controller="Appointment"
                          class="row g-2 align-items-end mb-4 pb-4 border-bottom">

                        @if (isReschedule)
                        {
                            <input type="hidden" name="id" value="@Model.AppointmentId" />
                        }
                        else
                        {
                            <input type="hidden" name="doctorId" value="@Model.DoctorId" />
                        }

                        <div class="col-8">
                            <label class="form-label">Choose a date</label>
                            <input type="date" name="date" class="form-control"
                                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-outline-secondary w-100">Check Availability</button>
                        </div>
                    </form>

                    <p class="fw-semibold mb-3">
                        Available slots on @Model.SelectedDate.ToString("dddd, dd MMM yyyy")
                    </p>

                    @if (!Model.AvailableSlots.Any())
                    {
                        <div class="alert alert-warning">
                            No available slots on this day. Please pick another date.
                        </div>
                    }
                    else
                    {
                        @* ---- Booking / Reschedule form ---- *@
                        <form asp-action="@(isReschedule ? "Reschedule" : "Book")" asp-controller="Appointment" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="DoctorId" />
                            <input type="hidden" asp-for="AppointmentId" />
                            <input type="hidden" asp-for="SelectedDate" />

                            <div class="row g-2 mb-4">
                                @foreach (var slot in Model.AvailableSlots)
                                {
                                    <div class="col-4 col-md-3">
                                        <input type="radio" class="btn-check" name="SelectedSlot"
                                               id="slot_@slot.Ticks"
                                               value="@slot.ToString("yyyy-MM-ddTHH:mm:ss")"
                                               autocomplete="off" />
                                        <label class="btn btn-outline-primary w-100" for="slot_@slot.Ticks">
                                            @slot.ToString("hh:mm tt")
                                        </label>
                                    </div>
                                }
                            </div>

                            @if (!isReschedule)
                            {
                                <div class="mb-4">
                                    <label asp-for="Notes" class="form-label"></label>
                                    <textarea asp-for="Notes" class="form-control" rows="3"
                                              placeholder="Anything you'd like the doctor to know (optional)"></textarea>
                                </div>
                            }

                            <button type="submit" class="btn btn-success btn-lg w-100 rounded-3">
                                @(isReschedule ? "Confirm Reschedule" : "Confirm Booking")
                            </button>
                        </form>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
