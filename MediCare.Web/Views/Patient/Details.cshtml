@using MediCare.Data.Models
@model Patient

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Patient Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-4">Patient Details</h2>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.User?.FullName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.User?.Email</dd>

                        <dt class="col-sm-4">Birth Date</dt>
                        <dd class="col-sm-8">@Model.BirthDate.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Age</dt>
                        <dd class="col-sm-8">@Model.Age</dd>

                        <dt class="col-sm-4">Blood Type</dt>
                        <dd class="col-sm-8">@(Model.BloodType ?? "—")</dd>

                        <dt class="col-sm-4">Emergency Contact</dt>
                        <dd class="col-sm-8">@(Model.EmergencyContact ?? "—")</dd>

                        <dt class="col-sm-4">Allergies</dt>
                        <dd class="col-sm-8">@(Model.Allergies ?? "—")</dd>
                    </dl>

                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                    <a asp-action="ManagePatients" asp-controller="Admin" class="btn btn-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
