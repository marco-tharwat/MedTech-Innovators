@model MediCare.Web.ViewModels.PrescriptionViewModel

@{
    ViewData["Title"] = "Prescription";
}

<style>
    body {
        background-color: #f5f5f5;
    }

    .prescription-container {
        max-width: 900px;
        margin: 30px auto;
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(0,0,0,.15);
    }

    .clinic-header {
        text-align: center;
        border-bottom: 2px solid #0d6efd;
        padding-bottom: 20px;
        margin-bottom: 30px;
    }

    .clinic-header h1 {
        margin-bottom: 5px;
        font-weight: bold;
    }

    .section-title {
        font-weight: bold;
        color: #0d6efd;
        margin-bottom: 10px;
        margin-top: 25px;
        font-size: 1.1rem;
    }

    .signature {
        margin-top: 80px;
        text-align: right;
    }

    .signature-line {
        display: inline-block;
        width: 250px;
        border-top: 1px solid black;
        padding-top: 8px;
        text-align: center;
    }

    .print-btn {
        margin-top: 30px;
    }

    @@media print {

        nav,
        footer,
        .print-btn,
        .btn {
            display: none !important;
        }

        body {
            background: white;
        }

        .prescription-container {
            box-shadow: none;
            margin: 0;
            width: 100%;
            max-width: 100%;
            border-radius: 0;
        }

        @@page {
            margin: 1.5cm;
        }
    }
</style>

<div class="prescription-container">

    <div class="clinic-header">

        <h1>MediCare Clinic</h1>

        <h4>Digital Prescription</h4>

        <small>
            Generated on @Model.Date.ToString("dd MMM yyyy")
        </small>

    </div>

    <div class="row">

        <div class="col-md-6">

            <div class="section-title">
                Doctor Information
            </div>

            <p>
                <strong>Name:</strong>
                @Model.DoctorName
            </p>

            <p>
                <strong>Specialization:</strong>
                @Model.Specialization
            </p>

        </div>

        <div class="col-md-6">

            <div class="section-title">
                Patient Information
            </div>

            <p>
                <strong>Name:</strong>
                @Model.PatientName
            </p>

            <p>
                <strong>Age:</strong>
                @Model.Age
            </p>

            <p>
                <strong>Date:</strong>
                @Model.Date.ToString("dd MMM yyyy")
            </p>

        </div>

    </div>

    <div class="section-title">
        Diagnosis
    </div>

    <div class="border rounded p-3 mb-4">

        @if (string.IsNullOrWhiteSpace(Model.Diagnosis))
        {
            <span class="text-muted">
                No diagnosis recorded.
            </span>
        }
        else
        {
            @Model.Diagnosis
        }

    </div>

    <div class="section-title">
        Medications
    </div>

    @if (!Model.Medications.Any())
    {
        <div class="alert alert-warning">
            No medications prescribed.
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle">

            <thead class="table-light">

                <tr>

                    <th>Medication</th>

                    <th>Dosage</th>

                    <th>Frequency</th>

                    <th>Duration</th>

                    <th>Instructions</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var medication in Model.Medications)
                {
                    <tr>

                        <td>
                            @medication.MedicationName
                        </td>

                        <td>
                            @medication.Dosage
                        </td>

                        <td>
                            @medication.Frequency
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(medication.Duration)
                                ? "-"
                                : medication.Duration)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(medication.Instructions)
                                ? "-"
                                : medication.Instructions)
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

    <div class="signature">

        <div class="signature-line">

            Doctor Signature

        </div>

    </div>

    <div class="text-center print-btn">

        <button onclick="window.print()"
                class="btn btn-primary btn-lg">

            Print Prescription

        </button>

    </div>

</div>