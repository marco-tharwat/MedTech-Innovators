@using MediCare.Services.DTO
@model IEnumerable<RegisteredAccountsData>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "All Registered Accounts";
}

<h2>All Registered Accounts</h2>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Registered On</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>
                    <span class="badge bg-@(user.Role switch {
                        "Admin" => "danger",
                        "Doctor" => "primary",
                        "Patient" => "success",
                        _ => "secondary"
                    })">@user.Role</span>
                </td>
                <td>@(user.Created?.ToString("g") ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>