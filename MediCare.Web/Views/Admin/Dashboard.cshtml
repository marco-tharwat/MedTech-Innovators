@using MediCare.Services.DTO
@model SummaryOfDataForAdmin

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <h1>Admin Dashboard</h1>
    <p>An overview of the clinic's doctors, patients and appointments.</p>
</div>

@* Icon are Disables because of a Frontend Bug on hovering (no time to fix it because it may change the whole frontend archeticture) *@
@* and it is not neccessary, just icons *@

<div class="row g-4 mb-2">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon">🩺</div>
            <div>
                <div class="stat-value">@Model.TotalNumberOfDoctors</div>
                <div class="stat-label">Doctors · @Model.DoctorsPending pending</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            @* <div class="stat-icon">🧑‍🤝‍🧑</div> *@
            <div>
                <div class="stat-value">@Model.TotalNumberOfPatients</div>
                <div class="stat-label">Registered patients</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            @* <div class="stat-icon">📅</div> *@
            <div>
                <div class="stat-value">@Model.NumOfAppointments</div>
                <div class="stat-label">Total appointments</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            @* <div class="stat-icon">📆</div> *@
            <div>
                <div class="stat-value">@Model.NumOfAppointmentsScheduledForToday</div>
                <div class="stat-label">Scheduled today</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-action="ManageDoctors" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">🩺</div> *@
            <h5 class="fw-bold mb-1">Manage Doctors</h5>
            <p class="text-muted mb-0">Add, edit, approve or remove doctor accounts.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-action="ManagePatients" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">🧑‍🤝‍🧑</div> *@
            <h5 class="fw-bold mb-1">Manage Patients</h5>
            <p class="text-muted mb-0">View and update registered patient records.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-action="AllAppointments" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">📅</div> *@
            <h5 class="fw-bold mb-1">Appointments</h5>
            <p class="text-muted mb-0">Browse and update every appointment in the clinic.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-action="Specializations_" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">🏷️</div> *@
            <h5 class="fw-bold mb-1">Specializations</h5>
            <p class="text-muted mb-0">Manage the specializations doctors can belong to.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-action="Reports" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">📈</div> *@
            <h5 class="fw-bold mb-1">Reports</h5>
            <p class="text-muted mb-0">Review clinic activity and summary reports.</p>
        </a>
    </div>
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-action="AllRegistered" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">👥</div> *@
            <h5 class="fw-bold mb-1">All Accounts</h5>
            <p class="text-muted mb-0">See every registered user account in one place.</p>
        </a>
    </div>
</div>