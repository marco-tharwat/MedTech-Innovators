<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MediCare.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">🩺</span>
                <span>MediCare</span>
            </a>

            <nav class="nav">
                <span class="sidebar-section-label">General</span>
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="nav-icon">🏠</span> Home
                </a>

                @* Admin Links *@
                @if (User.IsInRole("Admin"))
                {
                    <span class="sidebar-section-label">Administration</span>
                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                        <span class="nav-icon">📊</span> Dashboard
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="ManageDoctors">
                        <span class="nav-icon">🩺</span> Doctors
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="ManagePatients">
                        <span class="nav-icon">🧑‍🤝‍🧑</span> Patients
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="AllAppointments">
                        <span class="nav-icon">📅</span> Appointments
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Specializations_">
                        <span class="nav-icon">🏷️</span> Specializations
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                        <span class="nav-icon">📈</span> Reports
                    </a>
                    <a class="nav-link" asp-controller="Admin" asp-action="AllRegistered">
                        <span class="nav-icon">👥</span> All Accounts
                    </a>
                }

                @* Doctor Links *@
                @if (User.IsInRole("Doctor"))
                {
                    <span class="sidebar-section-label">My Practice</span>
                    <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                        <span class="nav-icon">📊</span> My Dashboard
                    </a>
                    <a class="nav-link" asp-controller="Appointment" asp-action="DoctorDailyList">
                        <span class="nav-icon">📅</span> Daily Appointments
                    </a>
                    <a class="nav-link" asp-controller="Appointment" asp-action="ManageWorkingHours">
                        <span class="nav-icon">🕒</span> Working Hours
                    </a>
                    <a class="nav-link" asp-controller="MedicalRecord" asp-action="CreateMedicalRecord">
                        <span class="nav-icon">📝</span> New Medical Record
                    </a>
                    <a class="nav-link" asp-controller="Doctor" asp-action="Filter">
                        <span class="nav-icon">🔎</span> Doctor Directory
                    </a>
                }

                @* Patient Links *@
                @if (User.IsInRole("Patient"))
                {
                    <span class="sidebar-section-label">My Care</span>
                    <a class="nav-link" asp-controller="Patient" asp-action="Index">
                        <span class="nav-icon">📊</span> My Dashboard
                    </a>
                    <a class="nav-link" asp-controller="Doctor" asp-action="Filter">
                        <span class="nav-icon">🔎</span> Find a Doctor
                    </a>
                    <a class="nav-link" asp-controller="Appointment" asp-action="PatientAppointments">
                        <span class="nav-icon">📅</span> My Appointments
                    </a>
                    <a class="nav-link" asp-controller="Patient" asp-action="Profile">
                        <span class="nav-icon">👤</span> My Profile
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                &copy; 2026 MediCare
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="topbar-toggle" type="button" id="sidebarToggle" aria-label="Toggle navigation">☰</button>
                    <span class="fw-semibold text-muted d-none d-sm-inline">@ViewData["Title"]</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-light btn-sm border rounded-3" asp-controller="Notification" asp-action="Index">
                            🔔 Notifications
                        </a>
                        <span class="text-muted d-none d-md-inline">Hello, <strong>@User.Identity.Name</strong></span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                            <button type="submit" class="btn btn-outline-primary btn-sm rounded-3">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm rounded-3" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-primary btn-sm rounded-3" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </header>

            <main class="app-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
