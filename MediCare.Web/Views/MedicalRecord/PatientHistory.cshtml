@model IEnumerable<MediCare.Data.Models.MedicalRecord>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Patient Medical History";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h3 class="mb-0">Patient Medical History</h3>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No medical records found.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Diagnosis</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var record in Model)
                            {
                                <tr>

                                    <td>
                                        @record.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @record.Diagnosis
                                    </td>

                                    <td>

                                        <a asp-action="GetRecordDetails"
                                           asp-route-medicalRecordId="@record.Id"
                                           class="btn btn-primary btn-sm">
                                            View Details
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>