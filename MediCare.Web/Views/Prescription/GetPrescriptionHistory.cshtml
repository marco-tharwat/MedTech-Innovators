cshtml
@model MediCare.Web.ViewModels.PrescriptionHistoryViewModel

@{
    ViewData["Title"] = "Prescription History";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Prescription History</h2>
    </div>

    @if (!Model.Prescriptions.Any())
    {
        <div class="alert alert-info">
            You don't have any prescriptions yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <h5 class="mb-0">Previous Prescriptions</h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-striped align-middle">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Doctor</th>
                                <th>Diagnosis</th>
                                <th>Medications</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var prescription in Model.Prescriptions)
                            {
                                <tr>

                                    <td>
                                        @prescription.Date.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @prescription.DoctorName
                                    </td>

                                    <td>
                                        @prescription.Diagnosis
                                    </td>

                                    <td>
                                        @prescription.MedicationCount
                                    </td>

                                    <td class="text-center">

                                        <a asp-controller="Prescription"
                                           asp-action="PrintPrescription"
                                           asp-route-medicalRecordId="@prescription.MedicalRecordId"
                                           class="btn btn-primary btn-sm">
                                            Print
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>
