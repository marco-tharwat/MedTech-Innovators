@{
    Layout = "_AdminLayout";
}
@using MediCare.Data.Models
@model Specialization

@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name - Doctors</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Fee</th>
            <th>Approved</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model.Doctors)
        {
            <tr>
                <td>@doctor.User?.FullName</td>
                <td>@doctor.Location</td>
                <td>@doctor.ConsultationFee</td>
                <td>
                    @if (doctor.IsApproved)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td>
                    <a asp-action="UpdateDoctor" asp-route-id="@doctor.Id" asp-route-specID="@Model.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="DeleteDoctor" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@doctor.Id" />
                        <input type="hidden" name="specID" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this doctor?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Specializations_" class="btn btn-secondary">Back</a>