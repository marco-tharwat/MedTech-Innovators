@using MediCare.Data.Models
@using MediCare.Data.Models.Enum
@model List<Appointment>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Daily Appointments";
    DateTime selectedDate = ViewBag.SelectedDate;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Daily Appointments</h2>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @* ---- Date picker ---- *@
            <form method="get" asp-action="DoctorDailyList" asp-controller="Appointment"
                  class="row g-2 align-items-end mb-4">
                <div class="col-8 col-md-4">
                    <label class="form-label">Date</label>
                    <input type="date" name="date" class="form-control"
                           value="@selectedDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-4 col-md-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">View</button>
                </div>
            </form>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3">
                    <strong>@selectedDate.ToString("dddd, dd MMM yyyy")</strong>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="p-5 text-center text-muted">
                            No appointments scheduled for this day.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Time</th>
                                    <th>Patient</th>
                                    <th>Status</th>
                                    <th>Notes</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in Model)
                                {
                                    <tr>
                                        <td class="ps-4">@appointment.AppointmentDate.ToString("hh:mm tt")</td>
                                        <td>@appointment.Patient.User.FullName</td>
                                        <td>
                                            <span class="badge rounded-pill @GetStatusBadgeClass(appointment.Status)">
                                                @appointment.Status
                                            </span>
                                        </td>
                                        <td class="text-muted">@(string.IsNullOrWhiteSpace(appointment.Notes) ? "—" : appointment.Notes)</td>
                                        <td class="text-end pe-4">
                                            @if (appointment.Status == Status.Pending)
                                            {
                                                <form asp-action="Approve" asp-controller="Appointment"
                                                      asp-route-id="@appointment.Id"
                                                      method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success me-1">Approve</button>
                                                </form>

                                                <form asp-action="Reject" asp-controller="Appointment"
                                                      asp-route-id="@appointment.Id"
                                                      method="post" class="d-inline"
                                                      onsubmit="return confirm('Reject this appointment?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">&mdash;</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            <a asp-controller="Doctor" asp-action="Index" class="btn btn-secondary mt-4">Back To Dashboard</a>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(Status status) => status switch
    {
        Status.Pending   => "bg-warning text-dark",
        Status.Confirmed => "bg-primary",
        Status.Completed => "bg-success",
        Status.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
}
