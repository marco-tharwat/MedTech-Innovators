@using MediCare.Services.DTO
@model DoctorSearchDTO

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Find a Doctor";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold mb-0">Find a Doctor</h2>
            </div>

            <form method="get" asp-action="Filter" class="row g-2 mb-4">
                <div class="col-md-4">
                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or specialization" />
                </div>
                <div class="col-md-3">
                    <select name="SpecializationId" class="form-select" asp-items="ViewBag.Specializations">
                        <option value="">All Specializations</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="text" name="Location" value="@Model.Location" class="form-control" placeholder="Location" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>

            @*
                Model.Doctors is Empty All the time while the Doctors Database has records for Doctors users, and they are valid for login
                Problem Might be from the _doctorService.SearchAsync() => the returned List is Empty
            *@

            @if (!Model.Doctors.Any()) 
            {
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="p-5 text-center text-muted">
                        No doctors found matching your search.
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var doctor in Model.Doctors)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card shadow-sm border-0 rounded-4 h-100">
                                <div class="card-body">
                                    <h5 class="card-title fw-bold mb-1">Dr. @doctor.User?.FullName</h5>
                                    <p class="text-muted mb-2">@doctor.Specialization?.Name</p>
                                    <p class="mb-1"><strong>Location:</strong> @(doctor.Location ?? "—")</p>
                                    <p class="mb-3"><strong>Consultation Fee:</strong> @doctor.ConsultationFee.ToString("C")</p>
                                    <a asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-outline-primary btn-sm">View Profile</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">
            @if (User.IsInRole("Patient"))
            {
                <a asp-controller="Patient" asp-action="Index" class="btn btn-secondary mt-4">Back To Dashboard</a>
            }
            else if (User.IsInRole("Doctor"))
            {
                <a asp-controller="Doctor" asp-action="Index" class="btn btn-secondary mt-4">Back To Dashboard</a>
            }
        </div>
    </div>
</div>
