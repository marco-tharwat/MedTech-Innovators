@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Doctor Dashboard";
    var name = User.Identity?.Name;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1>Welcome back, Dr. @name 👋</h1>
        <p>Here's everything you need to manage your practice today.</p>
    </div>
    <a asp-controller="Appointment" asp-action="DoctorDailyList" class="btn btn-primary">
        📅 Today's Appointments
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@* Icon are Disables because of a Frontend Bug on hovering (no time to fix it because it may change the whole frontend archeticture) *@
@* and it is not neccessary, just icons *@

<div class="row g-4">
    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-controller="Appointment" asp-action="DoctorDailyList" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">📅</div> *@
            <h5 class="fw-bold mb-1">Daily Appointments</h5>
            <p class="text-muted mb-0">Review, approve or reject the appointments booked with you for any day.</p>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-controller="Appointment" asp-action="ManageWorkingHours" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">🕒</div> *@
            <h5 class="fw-bold mb-1">Working Hours</h5>
            <p class="text-muted mb-0">Set the days and times you're available so patients can book valid slots.</p>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-controller="MedicalRecord" asp-action="CreateMedicalRecord" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">📝</div> *@
            <h5 class="fw-bold mb-1">New Medical Record</h5>
            <p class="text-muted mb-0">Document a diagnosis, symptoms and treatment plan for one of your patients.</p>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <a asp-controller="Doctor" asp-action="Filter" class="card h-100 p-4 text-decoration-none text-reset quick-action">
            @* <div class="stat-icon mb-3">🔎</div> *@
            <h5 class="fw-bold mb-1">Doctor Directory</h5>
            <p class="text-muted mb-0">Browse the clinic's doctors and specializations.</p>
        </a>
    </div>
</div>