@{
    Layout = "_AdminLayout";
}
@using MediCare.Data.Models
@model IEnumerable<Doctor>

@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="d-flex justify-content-between align-items-center">
    <h2>Manage Doctors</h2>
    <a asp-controller="Doctor" asp-action="Create" class="btn btn-primary">Add Doctor</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Specialization</th>
            <th>Location</th>
            <th>Fee</th>
            <th>Approved</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model)
        {
            <tr>
                <td>@doctor.User?.FullName</td>
                <td>@doctor.Specialization?.Name</td>
                <td>@doctor.Location</td>
                <td>@doctor.ConsultationFee</td>
                <td>
                    @if (doctor.IsApproved)
                    {
                        <span class="badge bg-success">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td>
                    <a asp-action="UpdateDoctor" asp-route-id="@doctor.Id" asp-route-specID="@doctor.SpecializationId" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-controller="Doctor" asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    <a asp-controller="Doctor" asp-action="Delete" asp-route-id="@doctor.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Dashboard" class="btn btn-secondary">Back</a>